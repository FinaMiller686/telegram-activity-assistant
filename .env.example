# Copy this file to .env and generate a random database password locally with
# scripts/setup-env.sh, or scripts/windows.ps1 setup on Windows.
# Never put Telegram or AI credentials in this file.
TGTLDR_DB_PASSWORD=
TGTLDR_HOST_WEB_PORT=3000
# Optional outbound proxy for Telegram user API.
# TGTLDR_TELEGRAM_PROXY_URL=socks5h://host.docker.internal:7890

# Set true only after confirming encrypted storage and key separation on the host.
TGTLDR_STORAGE_PROTECTED=false
